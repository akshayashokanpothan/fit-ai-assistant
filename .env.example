# ─────────────────────────────────────────────────────────────────────────
# Pace AI — environment configuration
#
# The app runs fully in DEMO MODE with none of these set: onboarding, chat,
# meal/activity logging, workouts, and history all work against a local
# browser-persisted store with an in-repo mock AI provider. Configure the
# variables below only when you're ready to connect real services.
#
# Never commit a real .env / .env.local file — only this template.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (optional — demo mode works without this) ────────────────────
# Project URL and publishable key, from Supabase → Project Settings → API.
# Used by the SSR client helpers in src/utils/supabase/*. Not yet wired into
# any route — the app still reads/writes through the local demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL, used to build stable auth redirect links (e.g. email
# confirmation). Without this, redirect URLs fall back to whatever origin
# the browser happened to be on (window.location.origin) — which is fine
# for local dev, but unsafe in production since it can bake an ephemeral
# Vercel preview/deployment URL into an emailed confirmation link instead
# of the canonical domain. Set this in Vercel to your production domain.
# Example: NEXT_PUBLIC_SITE_URL=https://paceai.akshayashokanpothan.com
NEXT_PUBLIC_SITE_URL=

# Service-role key — server-side ONLY. Never expose to the client.
# Required for: privileged server operations, the media cleanup cron route.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider selection ──────────────────────────────────────────────
# "mock" (default) uses the deterministic in-repo provider — no key needed.
# "anthropic" activates the real Anthropic adapter (requires the key below).
AI_PROVIDER=mock

# Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional — defaults to a current Claude model if unset. Check
# https://docs.claude.com for the latest available model names.
ANTHROPIC_MODEL=

# Reserved for future provider adapters — not yet implemented.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── Media cleanup cron (optional, only used once Supabase is configured) ──
# Shared secret checked against the Authorization: Bearer header on
# GET /api/cron/cleanup-media. Vercel Cron sends this automatically when
# this variable is set in your Vercel project.
CRON_SECRET=
